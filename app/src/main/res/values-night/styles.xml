<resources>

    <!--remove default splash screen  -->
    <style name="RemoveDefaultSplashScreen" parent="AppTheme">
        <item name="android:windowIsTranslucent">false</item>
    </style>
    <!-- Base application theme. -->
<!--    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">-->

    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
<!--    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">-->
        <!-- Primary Colors -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- Disable ActionBar -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- Transitions -->
        <item name="android:windowContentTransitions">true</item>

        <!-- Status Bar Color -->
        <item name="android:statusBarColor">@color/white</item>
        <!-- If you want white icons (dark background) -->
        <item name="android:windowLightStatusBar">false</item>
        <!-- Navigation Bar Color -->
        <item name="android:navigationBarColor">@color/white</item>
        <!-- For dark icons (use only if nav bar is light color) -->
        <!--        <item name="android:windowLightNavigationBar">false</item>-->

        <!-- DISABLE FORCE DARK -->
        <item name="android:forceDarkAllowed">false</item>

    </style>




    <style name="Theme.MyApp.Splash" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Fullscreen -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <!-- If you want white icons (dark background) -->
        <item name="android:windowLightStatusBar">false</item>
        <!-- Duration of animation -->
        <item name="windowSplashScreenAnimationDuration">500</item>
    </style>

