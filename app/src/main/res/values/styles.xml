    </style>-->
    <!--BottomSheet END-->

    <!--BottomSheet START-->
    <style name="CustomBottomSheetDialogTheme" parent="Theme.MaterialComponents.BottomSheetDialog"><!--BottomSheet-->
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowIsFloating">false</item>
    </style>
    <style name="CustomBottomSheetStyle" parent="Widget.MaterialComponents.BottomSheet.Modal"><!--BottomSheet-->
        <item name="shapeAppearanceOverlay">@style/BottomSheetShape</item>
    </style>
    <style name="BottomSheetShape"><!--BottomSheet-->
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">25dp</item>
        <item name="cornerSizeTopRight">25dp</item>
    </style>

    <style name="CustomBottomSheetDialogThemeDimBackground" parent="Theme.MaterialComponents.BottomSheetDialog"><!--BottomSheet-->
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyleDimBackground</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:windowIsFloating">true</item>
    </style>
    <style name="CustomBottomSheetStyleDimBackground" parent="Widget.MaterialComponents.BottomSheet.Modal"><!--BottomSheet-->
        <item name="shapeAppearanceOverlay">@style/BottomSheetShapeDimBackground</item>
    </style>
    <style name="BottomSheetShapeDimBackground"><!--BottomSheet-->
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">25dp</item>
        <item name="cornerSizeTopRight">25dp</item>
    </style>
    <!--BottomSheet END-->



    <style name="Theme_Dialog_4" parent="@style/Base.ThemeOverlay.AppCompat">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <!--<item name="android:windowMinWidthMajor">80%</item>
        <item name="android:windowMinWidthMinor">80%</item>-->
        <item name="android:windowSoftInputMode">adjustPan</item>
        <item name="android:windowAnimationStyle">@style/DialogAnimation2</item>
        <!--<item name="android:layout_marginStart">10dp</item>
        <item name="android:layout_marginEnd">10dp</item>-->
    </style>

    <style name="DialogAnimation2">
        <item name="android:windowEnterAnimation">@anim/bottom_to_top</item>
        <item name="android:windowExitAnimation">@anim/top_to_bottom</item>
    </style>


    <style name="dialogAnim" parent="@style/Base.ThemeOverlay.AppCompat">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:windowSoftInputMode">adjustPan</item>
        <item name="android:windowAnimationStyle">@style/DialogAnimationloader</item>
    </style>

    <style name="DialogAnimationloader">
        <!--<item name="android:windowEnterAnimation">@anim/slide_in_left</item>
        <item name="android:windowExitAnimation">@android:anim/slide_out_right</item>-->
        <item name="android:windowEnterAnimation">@anim/fade_in</item>
        <item name="android:windowExitAnimation">@anim/fade_out</item>
    </style>

</resources>
